// Prisma schema — QR Menu SaaS
// Source of truth for the data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
}

enum Locale {
  en
  ar
}

enum RestaurantStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  SENT
}

enum FulfillmentType {
  DINE_IN
  DELIVERY
}

enum PaymentMethodKey {
  CARD
  APPLE_PAY
  INSTAPAY
}

enum PaymentProvider {
  PAYMOB
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AnalyticsEventType {
  PAGE_VIEW
  ITEM_VIEW
  ORDER_INITIATED
  WHATSAPP_REDIRECT
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  emailVerified    DateTime? @map("email_verified_at")
  image            String?
  passwordHash     String?   @map("password_hash")
  name             String?
  role             UserRole  @default(OWNER)
  localePreference Locale    @default(en) @map("locale_preference")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  restaurants Restaurant[]
  payments    Payment[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

// NextAuth tables
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Plan {
  key                String   @id
  name               String
  nameAr             String?  @map("name_ar")
  maxItems           Int      @default(5)     @map("max_items")
  maxCategories      Int      @default(2)     @map("max_categories")
  monthlyPriceCents  Int      @default(0)     @map("monthly_price_cents")
  yearlyPriceCents   Int      @default(0)     @map("yearly_price_cents")
  sortOrder          Int      @default(0)     @map("sort_order")
  isActive           Boolean  @default(true)  @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt      @map("updated_at")

  accessibleThemes PlanTheme[]

  @@map("plans")
}

model PlanTheme {
  planKey String @map("plan_key")
  themeId String @map("theme_id") @db.Uuid

  plan  Plan  @relation(fields: [planKey], references: [key], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([planKey, themeId])
  @@map("plan_themes")
}

model Restaurant {
  id                    String           @id @default(uuid()) @db.Uuid
  ownerId               String           @map("owner_id") @db.Uuid
  slug                  String           @unique
  subdomain             String           @unique
  name                  String
  nameAr                String?          @map("name_ar")
  description           String?
  descriptionAr         String?          @map("description_ar")
  logoUrl               String?          @map("logo_url")
  whatsappNumber        String           @map("whatsapp_number")
  defaultLocale         Locale           @default(en) @map("default_locale")
  primaryColor          String           @default("#FF6B35") @map("primary_color")
  secondaryColor        String           @default("#1A1A2E") @map("secondary_color")
  accentColor           String           @default("#FFE8DE") @map("accent_color")
  heroImageUrls         String[]         @default([]) @map("hero_image_urls")
  heroPhotos            Json             @default("[]") @map("hero_photos")
  heroLayout            String           @default("featured") @map("hero_layout")
  heroImageScale        Int              @default(100) @map("hero_image_scale")
  themeId               String?          @map("theme_id") @db.Uuid
  themeCustomization    Json             @default("{}") @map("theme_customization")
  promoMessages         String[]         @default([]) @map("promo_messages")
  planKey               String           @default("free_trial") @map("plan_key")
  trialEndsAt           DateTime?        @map("trial_ends_at")
  status                RestaurantStatus @default(PENDING_PAYMENT)
  currencyCode          String           @default("EGP") @map("currency_code")
  taxPercent            Decimal          @default(0) @map("tax_percent") @db.Decimal(5, 2)
  serviceChargePercent  Decimal          @default(0) @map("service_charge_percent") @db.Decimal(5, 2)
  publishedAt           DateTime?        @map("published_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  theme      Theme?           @relation(fields: [themeId], references: [id])
  categories MenuCategory[]
  items      MenuItem[]
  orders          Order[]
  payments        Payment[]
  events          AnalyticsEvent[]
  supportMessages SupportMessage[]

  @@index([ownerId])
  @@index([status])
  @@map("restaurants")
}

model Theme {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique
  name             String
  nameAr           String?  @map("name_ar")
  description      String?
  descriptionAr    String?  @map("description_ar")
  previewImageUrl  String?  @map("preview_image_url")
  design           Json     @default("{}")
  isFree           Boolean  @default(false) @map("is_free")
  priceCents       Int      @default(0) @map("price_cents")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  restaurants Restaurant[]
  packages    ThemePackageTheme[]
  payments    Payment[]
  plans       PlanTheme[]

  @@map("themes")
}

model ThemePackage {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  nameAr        String?  @map("name_ar")
  description   String?
  descriptionAr String?  @map("description_ar")
  priceCents    Int      @map("price_cents")
  currencyCode  String   @default("EGP") @map("currency_code")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  themes   ThemePackageTheme[]
  payments Payment[]

  @@map("theme_packages")
}

model ThemePackageTheme {
  themeId   String @map("theme_id") @db.Uuid
  packageId String @map("package_id") @db.Uuid

  theme   Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)
  package ThemePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([themeId, packageId])
  @@map("theme_package_themes")
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  nameAr       String?  @map("name_ar")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  name          String
  nameAr        String?  @map("name_ar")
  description   String?
  descriptionAr String?  @map("description_ar")
  priceCents    Int      @map("price_cents")
  currencyCode  String   @default("EGP") @map("currency_code")
  imageUrl      String?  @map("image_url")
  isAvailable   Boolean  @default(true) @map("is_available")
  sortOrder     Int      @default(0) @map("sort_order")
  tags          String[] @default([])
  allergens     String[] @default([])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category     MenuCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  optionGroups MenuItemOptionGroup[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemOptionGroup {
  id           String  @id @default(uuid()) @db.Uuid
  itemId       String  @map("item_id") @db.Uuid
  name         String
  nameAr       String? @map("name_ar")
  minSelect    Int     @default(0) @map("min_select")
  maxSelect    Int     @default(1) @map("max_select")
  required     Boolean @default(false)
  sortOrder    Int     @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  item         MenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options      MenuItemOption[]

  @@index([itemId])
  @@map("menu_item_option_groups")
}

model MenuItemOption {
  id              String  @id @default(uuid()) @db.Uuid
  groupId         String  @map("group_id") @db.Uuid
  label           String
  labelAr         String? @map("label_ar")
  priceDeltaCents Int     @default(0) @map("price_delta_cents")
  sortOrder       Int     @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  group MenuItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("menu_item_options")
}

model Order {
  id                    String          @id @default(uuid()) @db.Uuid
  restaurantId          String          @map("restaurant_id") @db.Uuid
  fulfillmentType       FulfillmentType @default(DINE_IN) @map("fulfillment_type")
  tableNumber           String?         @map("table_number")
  customerName          String?         @map("customer_name")
  customerPhone         String?         @map("customer_phone")
  deliveryAddress       String?         @map("delivery_address")
  deliveryLat           Float?          @map("delivery_lat")
  deliveryLng           Float?          @map("delivery_lng")
  items                 Json
  totalCents            Int             @map("total_cents")
  currencyCode          String          @map("currency_code")
  customerLocale        Locale          @map("customer_locale")
  deviceInfo            String?         @map("device_info")
  whatsappRedirectedAt  DateTime?       @map("whatsapp_redirected_at")
  status                OrderStatus     @default(SENT)
  createdAt             DateTime        @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, fulfillmentType, createdAt])
  @@map("orders")
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  restaurantId          String          @map("restaurant_id") @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  provider              PaymentProvider @default(PAYMOB)
  providerOrderId       String?         @map("provider_order_id")
  providerTransactionId String?         @unique @map("provider_transaction_id")
  themePackageId        String?         @map("theme_package_id") @db.Uuid
  themeId               String?         @map("theme_id") @db.Uuid
  planKey               String?         @map("plan_key")
  amountCents           Int             @map("amount_cents")
  currencyCode          String          @map("currency_code")
  status                PaymentStatus   @default(PENDING)
  rawWebhookPayload     Json?           @map("raw_webhook_payload")
  paidAt                DateTime?       @map("paid_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  themePackage ThemePackage? @relation(fields: [themePackageId], references: [id])
  theme        Theme?        @relation(fields: [themeId], references: [id])
  webhookEvents PaymentWebhookEvent[]

  @@index([restaurantId])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String?  @map("payment_id") @db.Uuid
  providerOrderId String? @map("provider_order_id")
  hmacValid     Boolean  @map("hmac_valid")
  payload       Json
  receivedAt    DateTime @default(now()) @map("received_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, receivedAt])
  @@index([providerOrderId])
  @@map("payment_webhook_events")
}

/** Platform-wide toggle for each checkout payment method, controlled by admins. */
model PaymentMethodSetting {
  id        String           @id @default(uuid()) @db.Uuid
  method    PaymentMethodKey @unique
  isActive  Boolean          @default(true) @map("is_active")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("payment_method_settings")
}

model SupportMessage {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  senderRole   String   @map("sender_role")   // "OWNER" | "ADMIN"
  content      String
  readByAdmin  Boolean  @default(false) @map("read_by_admin")
  readByOwner  Boolean  @default(false) @map("read_by_owner")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("support_messages")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  actorEmail  String   @map("actor_email")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AnalyticsEvent {
  id           String             @id @default(uuid()) @db.Uuid
  restaurantId String             @map("restaurant_id") @db.Uuid
  eventType    AnalyticsEventType @map("event_type")
  metadata     Json?
  sessionId    String?            @map("session_id")
  occurredAt   DateTime           @default(now()) @map("occurred_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, occurredAt])
  @@index([eventType])
  @@map("analytics_events")
}
