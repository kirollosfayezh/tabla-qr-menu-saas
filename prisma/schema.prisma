// Prisma schema — QR Menu SaaS
// Source of truth for the data model. See plan.md §2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
}

enum Locale {
  en
  ar
}

enum RestaurantStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  SENT
}

enum PaymentProvider {
  PAYMOB
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AnalyticsEventType {
  PAGE_VIEW
  ITEM_VIEW
  ORDER_INITIATED
  WHATSAPP_REDIRECT
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  emailVerified    DateTime? @map("email_verified_at")
  image            String?
  passwordHash     String?   @map("password_hash")
  name             String?
  role             UserRole  @default(OWNER)
  localePreference Locale    @default(en) @map("locale_preference")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  restaurants Restaurant[]
  payments    Payment[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

// NextAuth tables
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Restaurant {
  id                    String           @id @default(uuid()) @db.Uuid
  ownerId               String           @map("owner_id") @db.Uuid
  slug                  String           @unique
  subdomain             String           @unique
  name                  String
  nameAr                String?          @map("name_ar")
  description           String?
  descriptionAr         String?          @map("description_ar")
  logoUrl               String?          @map("logo_url")
  whatsappNumber        String           @map("whatsapp_number")
  defaultLocale         Locale           @default(en) @map("default_locale")
  primaryColor          String           @default("#FF6B35") @map("primary_color")
  secondaryColor        String           @default("#1A1A2E") @map("secondary_color")
  accentColor           String           @default("#FFE8DE") @map("accent_color")
  themeId               String?          @map("theme_id") @db.Uuid
  status                RestaurantStatus @default(PENDING_PAYMENT)
  currencyCode          String           @default("EGP") @map("currency_code")
  taxPercent            Decimal          @default(0) @map("tax_percent") @db.Decimal(5, 2)
  serviceChargePercent  Decimal          @default(0) @map("service_charge_percent") @db.Decimal(5, 2)
  publishedAt           DateTime?        @map("published_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  theme      Theme?           @relation(fields: [themeId], references: [id])
  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]
  payments   Payment[]
  events     AnalyticsEvent[]

  @@index([ownerId])
  @@index([status])
  @@map("restaurants")
}

model Theme {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique
  name             String
  nameAr           String?  @map("name_ar")
  description      String?
  descriptionAr    String?  @map("description_ar")
  previewImageUrl  String?  @map("preview_image_url")
  isFree           Boolean  @default(false) @map("is_free")
  priceCents       Int      @default(0) @map("price_cents")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  restaurants Restaurant[]
  packages    ThemePackageTheme[]

  @@map("themes")
}

model ThemePackage {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  nameAr        String?  @map("name_ar")
  description   String?
  descriptionAr String?  @map("description_ar")
  priceCents    Int      @map("price_cents")
  currencyCode  String   @default("EGP") @map("currency_code")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  themes   ThemePackageTheme[]
  payments Payment[]

  @@map("theme_packages")
}

model ThemePackageTheme {
  themeId   String @map("theme_id") @db.Uuid
  packageId String @map("package_id") @db.Uuid

  theme   Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)
  package ThemePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([themeId, packageId])
  @@map("theme_package_themes")
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  nameAr       String?  @map("name_ar")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  name          String
  nameAr        String?  @map("name_ar")
  description   String?
  descriptionAr String?  @map("description_ar")
  priceCents    Int      @map("price_cents")
  currencyCode  String   @default("EGP") @map("currency_code")
  imageUrl      String?  @map("image_url")
  isAvailable   Boolean  @default(true) @map("is_available")
  sortOrder     Int      @default(0) @map("sort_order")
  tags          String[] @default([])
  allergens     String[] @default([])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  restaurantId          String      @map("restaurant_id") @db.Uuid
  tableNumber           String?     @map("table_number")
  items                 Json
  totalCents            Int         @map("total_cents")
  currencyCode          String      @map("currency_code")
  customerLocale        Locale      @map("customer_locale")
  deviceInfo            String?     @map("device_info")
  whatsappRedirectedAt  DateTime?   @map("whatsapp_redirected_at")
  status                OrderStatus @default(SENT)
  createdAt             DateTime    @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("orders")
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  restaurantId          String          @map("restaurant_id") @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  provider              PaymentProvider @default(PAYMOB)
  providerOrderId       String?         @map("provider_order_id")
  providerTransactionId String?         @unique @map("provider_transaction_id")
  themePackageId        String?         @map("theme_package_id") @db.Uuid
  amountCents           Int             @map("amount_cents")
  currencyCode          String          @map("currency_code")
  status                PaymentStatus   @default(PENDING)
  rawWebhookPayload     Json?           @map("raw_webhook_payload")
  paidAt                DateTime?       @map("paid_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  themePackage ThemePackage? @relation(fields: [themePackageId], references: [id])

  @@index([restaurantId])
  @@index([status])
  @@map("payments")
}

model AnalyticsEvent {
  id           String             @id @default(uuid()) @db.Uuid
  restaurantId String             @map("restaurant_id") @db.Uuid
  eventType    AnalyticsEventType @map("event_type")
  metadata     Json?
  sessionId    String?            @map("session_id")
  occurredAt   DateTime           @default(now()) @map("occurred_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, occurredAt])
  @@index([eventType])
  @@map("analytics_events")
}
