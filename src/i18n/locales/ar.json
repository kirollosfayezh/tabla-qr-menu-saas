    "terms": {
      "title": "شروط الخدمة",
      "lastUpdated": "آخر تحديث: {date}",
      "s1": { "title": "١. القبول", "body": "بإنشائك حسابًا في طبلة، فإنك توافق على شروط الخدمة وسياسات الخصوصية والاسترداد وملفات تعريف الارتباط. إن لم توافق فلا تستخدم الخدمة." },
      "s2": { "title": "٢. حسابك", "body": "أنت مسؤول عن حماية كلمة المرور وكل نشاط على حسابك، وعن دقة بيانات الفوترة وبريد التواصل." },
      "s3": { "title": "٣. الاستخدام المقبول", "body": "ممنوع استخدام طبلة لنشر محتوى غير قانوني أو انتهاك حقوق الملكية أو الاحتيال. قد نوقف أي مطعم يخالف هذه القواعد." },
      "s4": { "title": "٤. الدفع والاشتراكات", "body": "تتم معالجة شراء السمات عبر Paymob. تخوّلنا بخصم المبلغ المعروض من وسيلة الدفع التي اخترتها." },
      "s5": { "title": "٥. توفر الخدمة", "body": "نسعى لتقديم خدمة مستقرة، لكننا لا نضمن استمرارها دون انقطاع." },
      "s6": { "title": "٦. حدود المسؤولية", "body": "تُقدَّم الخدمة كما هي. الحد الأقصى لمسؤوليتنا هو المبالغ التي دفعتها خلال آخر ١٢ شهرًا." },
      "contact": { "title": "تواصل", "body": "support@tabla.app" }
    },
    "privacy": {
      "title": "سياسة الخصوصية",
      "lastUpdated": "آخر تحديث: {date}",
      "s1": { "title": "١. البيانات التي نجمعها", "body": "بيانات الحساب (البريد والاسم)، بيانات المطعم التي تدخلها، بيانات وصفية للدفع (لا نخزّن أرقام البطاقات)، بيانات الطلبات، وسجلات تشغيلية." },
      "s2": { "title": "٢. كيف نستخدمها", "body": "لتشغيل الخدمة وإرسال البريد المعاملاتي ومنع الإساءة وتحسين الميزات. لا نبيع بياناتك." },
      "s3": { "title": "٣. مزوّدو الخدمة", "body": "Supabase، Cloudflare R2، Upstash، Paymob، Resend، Cloudflare Turnstile، Sentry. لكل مزوّد سياسته الخاصة." },
      "s4": { "title": "٤. حقوقك", "body": "تستطيع الاطلاع على بياناتك أو تصديرها أو تصحيحها أو حذفها من صفحة الحساب. نرد خلال ٣٠ يومًا." },
      "s5": { "title": "٥. الاحتفاظ", "body": "نحتفظ بالبيانات طوال نشاط الحساب. بعد الحذف نمسحها خلال ١٤ يومًا، باستثناء ما تتطلبه السجلات المالية (٧ سنوات)." },
      "s6": { "title": "٦. النقل الدولي", "body": "قد تُعالج البيانات خارج بلدك عبر المزودين أعلاه." },
      "contact": { "title": "تواصل", "body": "privacy@tabla.app" }
    },
    "refunds": {
      "title": "سياسة الاسترداد",
      "lastUpdated": "آخر تحديث: {date}",
      "s1": { "title": "١. شراء السمات", "body": "يمكن استرداد ثمن السمة خلال ١٤ يومًا من الشراء إذا لم تُستخدم لنشر قائمة عامة، أو في حال عيب مُتحقَّق منه." },
      "s2": { "title": "٢. طلب الاسترداد", "body": "راسلنا على support@tabla.app مع بريد الحساب ورقم الطلب. نرد خلال ٣ أيام عمل ونعالج المعتمد خلال ٧ أيام عمل." },
      "s3": { "title": "٣. طريقة الاسترداد", "body": "يُعاد المبلغ إلى وسيلة الدفع الأصلية عبر Paymob؛ قد يستغرق البنك ٥-١٠ أيام عمل إضافية." },
      "s4": { "title": "٤. الاعتراضات على الدفع", "body": "تواصل معنا أولًا. الاعتراض غير المبرر قد يؤدي إلى إيقاف الحساب وتحميل الرسوم." },
      "contact": { "title": "تواصل", "body": "support@tabla.app" }
    },
    "cookies": {
      "title": "سياسة ملفات تعريف الارتباط",
      "lastUpdated": "آخر تحديث: {date}",
      "s1": { "title": "١. ما نستخدمه", "body": "ملفات ضرورية: جلسة Auth.js، حماية CSRF، تفضيل اللغة. لا يمكن تعطيلها ولا تُستخدم للتحليلات." },
      "s2": { "title": "٢. مزوّدون آخرون", "body": "تستخدم Cloudflare Turnstile ملف ارتباط للتحقق من أنك لست روبوتًا. تستخدم Google ملفات ارتباط عند تسجيل الدخول عبر OAuth." },
      "s3": { "title": "٣. خياراتك", "body": "يمكنك مسح ملفات الارتباط من المتصفح؛ مسح ملف الجلسة سيُسجّل خروجك." },
      "contact": { "title": "تواصل", "body": "privacy@tabla.app" }
    }
