# Copy to .env.local (the db:* scripts load .env.local) and fill in real values.
# Server variables are validated at boot by src/config/env.ts.

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database (PostgreSQL via Prisma) -------------------------------------
# Pooled connection string used by the app
DATABASE_URL=postgresql://user:password@localhost:5432/tabla
# Optional direct (non-pooled) connection string
DIRECT_URL=

# --- Auth (NextAuth v5) ---------------------------------------------------
# At least 32 characters, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=replace-with-a-random-string-of-32-plus-chars
# Public base URL NextAuth uses for callbacks
NEXTAUTH_URL=http://localhost:3000
# Optional Google OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Multi-tenant routing -------------------------------------------------
# Root domain; restaurants are served at <slug>.<root> or <root>/<slug>
APP_ROOT_DOMAIN=localhost
# Public URL of the app (used in emails, QR codes and payment callbacks)
APP_PUBLIC_URL=http://localhost:3000

# --- Rate limiting (Upstash Redis) ----------------------------------------
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key — safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional service-role key (server only, never expose)
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot protection (Cloudflare Turnstile, optional) ----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Image storage (Cloudflare R2, optional) ------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL that serves the bucket's objects
R2_PUBLIC_URL=

# --- Payments (Paymob, optional) ------------------------------------------
PAYMOB_API_KEY=
# HMAC secret used to verify webhook callbacks
PAYMOB_HMAC_SECRET=
# Card integration ID
PAYMOB_INTEGRATION_ID=
# Apple Pay integration ID
PAYMOB_APPLE_PAY_INTEGRATION_ID=
# Hosted iframe ID
PAYMOB_IFRAME_ID=

# --- Transactional email (Resend, optional) -------------------------------
# Sender address, e.g. no-reply@yourdomain.com
EMAIL_FROM=
RESEND_API_KEY=

# --- InstaPay manual payments (client-side, optional) ---------------------
# Phone number shown to owners for InstaPay transfers
NEXT_PUBLIC_INSTAPAY_PHONE=
# EmailJS credentials used to notify the admin of an InstaPay request
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
